@model WebApp.Areas.Admin.ViewModels.Post.EditPostViewModel
@{
    ViewData["Title"] = "Edit Post: " + Model.Title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusBadgeClass = Model.IsDeleted ? "bg-danger" : (Model.IsPublished ? "bg-success" : "bg-secondary");
    var statusLabel = Model.IsDeleted ? "Trashed" : (Model.IsPublished ? "Published" : "Draft");
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Edit Post</h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @statusBadgeClass fs-6">@statusLabel</span>
                @if (!string.IsNullOrEmpty(Model.Slug))
                {
                    @if (Model.IsPublished)
                    {
                        <a href="@Url.Action("Post", "Blog", new { area = "", slug = Model.Slug })" target="_blank" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View live
                        </a>
                    }
                    <a asp-action="Preview" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-eye me-1"></i>Preview
                    </a>
                }
            </div>
        </div>

        @if (Model.IsPublished && !string.IsNullOrEmpty(Model.Slug))
        {
            <div class="px-4 pt-3">
                <div class="alert alert-info d-flex align-items-start gap-2 mb-0 py-2">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Published</strong> at
                        <code>/blog/@Model.Slug</code>.
                        Changing the title will <strong>not</strong> update the slug — existing links stay valid.
                    </div>
                </div>
            </div>
        }

        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="editPostForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Title -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold">Title</label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter post title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Featured Image Upload -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Featured Image</label>
                    <div class="card border-dashed bg-light" id="image-upload-container">
                        <!-- Placeholder: Show if NO image -->
                        <div class="card-body text-center py-5 @(!string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "d-none" : "")" id="upload-placeholder">
                            <div class="mb-3">
                                <i class="bi bi-cloud-arrow-up text-muted" style="font-size: 3rem;"></i>
                            </div>
                            <h6 class="text-muted">Drag and drop or click to replace</h6>
                            <p class="text-muted small mb-2">Supported formats: JPG, PNG, GIF, WebP</p>
                            <p class="text-muted small mb-3">Max size: 10&nbsp;MB</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('featuredImageFile').click()">
                                Choose File
                            </button>
                            <input type="file" id="featuredImageFile" class="d-none" accept="image/png, image/jpeg, image/gif, image/webp">
                        </div>

                        <!-- Preview: Show if image EXISTS -->
                        <div class="card-body text-center position-relative p-0 @(string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "d-none" : "")" id="upload-preview-container">
                            <img id="image-preview" src="@Model.FeaturedImageUrl" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 p-3">
                                <button type="button" class="btn btn-light btn-sm shadow-sm text-danger" id="remove-image-btn" title="Remove Image">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="card-body text-center d-none py-5" id="upload-loading">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <p class="text-muted">Uploading image...</p>
                        </div>
                    </div>
                    <div id="upload-error" class="text-danger small mt-1 d-none"></div>
                    <!-- Hidden input stores the JSON or URL -->
                    <input type="hidden" asp-for="FeaturedImageUrl" id="FeaturedImageUrl" />
                    <span asp-validation-for="FeaturedImageUrl" class="text-danger"></span>
                </div>

                <!-- Featured Image Alt Text -->
                <div class="mb-4">
                    <label asp-for="FeaturedImageAlt" class="form-label fw-bold">Featured Image Alt Text</label>
                    <input asp-for="FeaturedImageAlt" class="form-control" placeholder="Describe the image for screen readers and SEO" />
                    <span asp-validation-for="FeaturedImageAlt" class="text-danger"></span>
                </div>

                <!-- Category & Tags -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                        <select asp-for="CategoryId" asp-items="Model.AvailableCategories" class="form-select" id="category-select">
                            <option value="">Select a category...</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SelectedTagIds" class="form-label fw-bold">Tags</label>
                        <select asp-for="SelectedTagIds" asp-items="Model.AvailableTags" class="form-select" multiple id="tags-select">
                        </select>
                        <span asp-validation-for="SelectedTagIds" class="text-danger"></span>
                    </div>
                </div>

                <!-- Content Editor -->
                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-bold">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="15"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <!-- Publish Options -->
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="PublishNow" class="form-check-input" type="checkbox" role="switch" id="publishSwitch">
                            <label class="form-check-label fw-bold" for="publishSwitch">
                                @(Model.IsPublished ? "Published" : "Publish Immediately")
                            </label>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 flex-fill flex-md-grow-0">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold flex-fill flex-md-grow-0">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_EditorScripts" />
}