@model WebApp.Areas.Admin.ViewModels.Post.PostViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Header -->
<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="h3 mb-0">Post Details</h1>
        <small class="text-muted">Preview of how the post will be rendered.</small>
    </div>
    <div class="col-auto">
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>Edit Post
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="h4 mb-0">@Model.Title</h2>
        <small class="text-muted">
            @if (Model.IsPublished && Model.PublishedDate.HasValue)
            {
                <text>Published on @Model.PublishedDate.Value.ToString("MMMM dd, yyyy")</text>
            }
            else
            {
                <span class="badge bg-secondary">Draft</span>
            }
        </small>
    </div>
    <div class="card-body">
        <div class="post-content">
            @* This is where the magic happens. The Tag Helper converts the Markdown to HTML. *@
            <markdown>@Model.Content</markdown>
        </div>
    </div>
</div>