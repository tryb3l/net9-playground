<!-- Pinned with integrity hashes: these URLs previously resolved to "latest", so an
     upstream release could break the editor with no deploy on our side. -->

<!-- EasyMDE -->
<link rel="stylesheet" href="https://unpkg.com/easymde@2.21.0/dist/easymde.min.css"
      integrity="sha384-ZoLYv3S+AsZX+zhbN1D1+WPpc8f+DmLfxfgw+qn0Nq8wJPOYQQXEW5ZrRhcGozlG"
      crossorigin="anonymous">
<script src="https://unpkg.com/easymde@2.21.0/dist/easymde.min.js"
        integrity="sha384-mTM6vzy+/UiHrMBClNGViM9qEv0/26iCGqpJKhSzdnjrxbKjO3vkT62ujXQ8B5iv"
        crossorigin="anonymous"></script>

<!-- Choices.js -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.2.4/public/assets/styles/choices.min.css"
      integrity="sha384-uLFsUvpIOC9MdzZeDr7vuIUG6LgTaguBn469csIwzNIG9N9TFVoYgM4Ov5PG1V1l"
      crossorigin="anonymous" />
<script src="https://cdn.jsdelivr.net/npm/choices.js@11.2.4/public/assets/scripts/choices.min.js"
        integrity="sha384-0dGX4oSRqvcKtSNa5YGzTI3pkW4p3uoor1Izx0R5/7emRjiR619oCIBVnvM9k3tj"
        crossorigin="anonymous"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
    // 1. Initialize Choices.js for Category and Tags
    const categorySelect = new Choices('#category-select', {
    searchEnabled: true,
    itemSelectText: '',
    placeholder: true,
    placeholderValue: 'Select a category'
    });

    const tagsSelect = new Choices('#tags-select', {
    removeItemButton: true,
    searchEnabled: true,
    placeholder: true,
    placeholderValue: 'Select tags',
    noChoicesText: 'No tags available'
    });

    // 2. Initialize EasyMDE
    const easyMDE = new EasyMDE({
    element: document.getElementById('Content'),
    spellChecker: false,
    placeholder: "Start writing your masterpiece...",
    // No "autosave" here: EasyMDE only autosaves when the `autosave` option below is
    // configured, and listing it in the status bar without that advertised a safety net
    // that did not exist. Unsaved work is guarded by the beforeunload handler instead.
    status: ["lines", "words", "cursor"],
    minHeight: "400px",
    uploadImage: true,
    imageUploadFunction: (file, onSuccess, onError) => {
    const formData = new FormData();
    formData.append('image', file);
    // Get CSRF token
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    fetch('/Admin/api/Attachments/editor-upload', {
    method: 'POST',
    body: formData,
    headers: {
    'RequestVerificationToken': token
    }
    })
    .then(r => r.json())
    .then(d => {
    if (d.success) onSuccess(d.file.url);
    else onError(d.message);
    })
    .catch(e => onError(e.message));
    }
    });

    // 3. Featured Image Upload Logic
    const fileInput = document.getElementById('featuredImageFile');
    const hiddenInput = document.getElementById('FeaturedImageUrl');
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const previewContainer = document.getElementById('upload-preview-container');
    const loadingContainer = document.getElementById('upload-loading');
    const previewImg = document.getElementById('image-preview');
    const removeBtn = document.getElementById('remove-image-btn');
    const uploadError = document.getElementById('upload-error');

    const ALLOWED_TYPES = ['image/png', 'image/jpeg', 'image/gif', 'image/webp'];
    const MAX_BYTES = 10 * 1024 * 1024;

    function showUploadError(msg) {
    if (uploadError) {
    uploadError.textContent = msg;
    uploadError.classList.remove('d-none');
    }
    }

    function clearUploadError() {
    if (uploadError) {
    uploadError.textContent = '';
    uploadError.classList.add('d-none');
    }
    }

    fileInput.addEventListener('change', function () {
    if (this.files && this.files[0]) {
    const file = this.files[0];
    clearUploadError();

    // Client-side validation
    if (!ALLOWED_TYPES.includes(file.type)) {
    showUploadError('Unsupported file type. Please upload a JPG, PNG, GIF, or WebP image.');
    fileInput.value = '';
    return;
    }
    if (file.size > MAX_BYTES) {
    showUploadError('File is too large. Maximum allowed size is 10 MB.');
    fileInput.value = '';
    return;
    }

    // Show loading
    uploadPlaceholder.classList.add('d-none');
    previewContainer.classList.add('d-none');
    loadingContainer.classList.remove('d-none');
    markDirty();

    const formData = new FormData();
    formData.append('filepond', file); // Controller expects 'filepond'

    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    fetch('/Admin/api/Attachments/upload', {
    method: 'POST',
    body: formData,
    headers: {
    'RequestVerificationToken': token
    }
    })
    .then(response => response.json().then(data => ({ ok: response.ok, data })))
    .then(({ ok, data }) => {
    loadingContainer.classList.add('d-none');

    if (!ok) {
    const msg = data?.message || 'Upload failed. Please try again.';
    showUploadError(msg);
    uploadPlaceholder.classList.remove('d-none');
    fileInput.value = '';
    return;
    }

    if (data.urls) {
    // Store JSON in hidden input
    hiddenInput.value = JSON.stringify(data.urls);

    // Show preview (use large or original)
    previewImg.src = data.urls.large || data.urls.original;
    previewContainer.classList.remove('d-none');
    } else {
    showUploadError('Unexpected server response. Please try again.');
    uploadPlaceholder.classList.remove('d-none');
    fileInput.value = '';
    }
    })
    .catch(error => {
    loadingContainer.classList.add('d-none');
    uploadPlaceholder.classList.remove('d-none');
    showUploadError('Network error during upload. Please try again.');
    fileInput.value = '';
    });
    }
    });

    removeBtn.addEventListener('click', function () {
    fileInput.value = '';
    hiddenInput.value = '';
    previewContainer.classList.add('d-none');
    uploadPlaceholder.classList.remove('d-none');
    clearUploadError();
    markDirty();
    });

    // 4. Dirty-form detection
    let formDirty = false;
    let formSubmitted = false;

    const previewBtn = document.getElementById('previewBtn');
    const previewHint = document.getElementById('previewHint');

    function markDirty() {
    formDirty = true;
    // Preview renders the last *saved* version, so offering it mid-edit silently shows
    // stale content (target="_blank" means beforeunload never fires to warn about it).
    if (previewBtn) {
    previewBtn.classList.add('disabled');
    previewBtn.setAttribute('aria-disabled', 'true');
    }
    if (previewHint) previewHint.classList.remove('d-none');
    }

    if (previewBtn) {
    previewBtn.addEventListener('click', function (e) {
    if (formDirty) e.preventDefault();
    });
    }

    // 5. Inline tag creation
    const newTagInput = document.getElementById('new-tag-name');
    const addTagBtn = document.getElementById('add-tag-btn');
    const newTagError = document.getElementById('new-tag-error');

    function showTagError(message) {
    if (!newTagError) return;
    newTagError.textContent = message;
    newTagError.classList.remove('d-none');
    }

    function addTag() {
    const name = (newTagInput.value || '').trim();
    if (!name) return;

    if (newTagError) newTagError.classList.add('d-none');
    addTagBtn.disabled = true;

    const body = new FormData();
    body.append('name', name);

    fetch('/Admin/Tag/QuickCreate', {
    method: 'POST',
    body: body,
    headers: {
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
    }
    })
    .then(r => r.json())
    .then(d => {
    addTagBtn.disabled = false;

    if (!d.success) {
    showTagError(d.message || 'Could not add the tag.');
    return;
    }

    const value = String(d.id);
    const alreadyListed = tagsSelect.passedElement.element
    .querySelector('option[value="' + value + '"]');

    if (alreadyListed) {
    tagsSelect.setChoiceByValue(value);
    } else {
    tagsSelect.setChoices([{ value: value, label: d.name, selected: true }], 'value', 'label', false);
    }

    newTagInput.value = '';
    markDirty();
    })
    .catch(() => {
    addTagBtn.disabled = false;
    showTagError('Could not add the tag. Please try again.');
    });
    }

    if (addTagBtn && newTagInput) {
    addTagBtn.addEventListener('click', addTag);
    newTagInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
    // Otherwise Enter submits the whole post form.
    e.preventDefault();
    addTag();
    }
    });
    }

    // Capture baselines after full initialization
    const titleInput = document.getElementById('Title');
    const publishSwitch = document.getElementById('publishSwitch');
    const altInput = document.getElementById('FeaturedImageAlt');

    if (titleInput) titleInput.addEventListener('input', markDirty);
    if (publishSwitch) publishSwitch.addEventListener('change', markDirty);
    if (altInput) altInput.addEventListener('input', markDirty);

    categorySelect.passedElement.element.addEventListener('change', markDirty);
    tagsSelect.passedElement.element.addEventListener('change', markDirty);

    easyMDE.codemirror.on('change', markDirty);

    const form = document.getElementById('createPostForm') || document.getElementById('editPostForm');
    if (form) {
    form.addEventListener('submit', function () { formSubmitted = true; });
    }

    window.addEventListener('beforeunload', function (e) {
    if (formDirty && !formSubmitted) {
    e.preventDefault();
    e.returnValue = '';
    }
    });
    });
</script>

<style>
    .border-dashed {
    border-style: dashed !important;
    border-width: 2px !important;
    }

    /* Choices.js overrides for Bootstrap 5 consistency */
    .choices__inner {
    background-color: #fff;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    }

    .choices__input {
    background-color: transparent;
    }
</style>