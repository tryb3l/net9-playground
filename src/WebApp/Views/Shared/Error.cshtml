@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2 text-center">
            @if (Model.StatusCode.HasValue)
            {
                <p class="display-1 fw-bold text-muted mb-0">@Model.StatusCode</p>
            }

            <h1 class="mb-3">@Model.Title</h1>
            <p class="lead text-muted">@Model.Message</p>

            <a class="btn btn-primary mt-3" asp-controller="Blog" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i>Back to the blog
            </a>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mt-4">
                    Request ID: <code>@Model.RequestId</code>
                </p>
            }
        </div>
    </div>
</div>
