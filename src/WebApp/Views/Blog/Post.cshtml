@model WebApp.Areas.Admin.ViewModels.Post.PostViewModel
@{
    ViewData["Title"] = Model.Title;
    bool isPreview = ViewData["IsPreview"] is true;
}

@if (isPreview)
{
    <div class="alert alert-warning text-center mb-0 rounded-0 border-0 border-bottom">
        <i class="bi bi-eye me-1"></i>
        <strong>Draft Preview</strong> — this post is not publicly visible.
        <a href="javascript:window.close()" class="ms-3 btn btn-sm btn-outline-warning">Close preview</a>
    </div>
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <article class="post-full">
                <header class="post-full-header">
                    <h1 class="post-full-title">@Model.Title</h1>
                    <div class="post-full-meta">
                        @if (Model.PublishedDate.HasValue)
                        {
                            <time datetime="@Model.PublishedDate.Value.ToString("yyyy-MM-dd")">@Model.PublishedDate.Value.ToString("MMMM dd, yyyy")</time>
                        }
                        else
                        {
                            <span>Draft</span>
                        }
                        <span class="bull">&bull;</span> @Model.AuthorName
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                {
                    <div class="post-cover-container">
                        <div class="post-cover-background" style="background-image: url('@Model.FeaturedImageUrl');"></div>
                        <img class="post-cover-image" src="@Model.FeaturedImageUrl" alt="@(Model.FeaturedImageAlt ?? Model.Title)" />
                    </div>
                }

                <section class="post-full-content">
                    <markdown>@Model.Content</markdown>
                </section>

                @if (Model.Tags.Any())
                {
                    <footer class="post-full-footer">
                        <div class="post-tags">
                            @foreach (var tagName in Model.Tags)
                            {
                                <a href="@Url.Action("Index", "Blog", new { tag = tagName })" class="tag-link">#@tagName</a>
                            }
                        </div>
                    </footer>
                }
            </article>
        </div>
    </div>
</div>